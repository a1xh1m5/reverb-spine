// MOTION — TIDAL Animated Artwork for 8SPINE
// Standalone artwork module. Does not contain or modify Lumen source.
// v1.0.0 — TIDAL only

const MODULE_VERSION = '1.0.0';
const TIDAL_API = 'https://tidal.alx12.dpdns.org';
const ISRC_API = 'https://isrc.xander12.workers.dev';

const POSITIVE_TTL = 6 * 60 * 60 * 1000;
const NEGATIVE_TTL = 30 * 60 * 1000;
const MAX_CACHE_SIZE = 250;

const cache = new Map();
const pending = new Map();

function normalizeIsrc(value) {
  const candidate = String(value || '').trim().toUpperCase();
  return /^[A-Z]{2}[A-Z0-9]{3}[0-9]{7}$/.test(candidate) ? candidate : null;
}

function findIsrc(value, depth) {
  if (!value || typeof value !== 'object' || depth > 5) return null;

  const direct = normalizeIsrc(
    value.isrc || value.ISRC || value.isrcCode ||
    (value.externalIds && value.externalIds.isrc)
  );
  if (direct) return direct;

  const keys = ['track', 'metadata', 'item', 'context', 'currentTrack', 'nowPlaying', 'mediaItem'];
  for (const key of keys) {
    const found = findIsrc(value[key], depth + 1);
    if (found) return found;
  }
  return null;
}

function contextIsrc(args) {
  for (const arg of args) {
    const found = findIsrc(arg, 0);
    if (found) return found;
  }
  return null;
}

function readCache(key) {
  const entry = cache.get(key);
  if (!entry) return undefined;
  if (entry.expiresAt <= Date.now()) {
    cache.delete(key);
    return undefined;
  }
  cache.delete(key);
  cache.set(key, entry);
  return entry.value;
}

function writeCache(key, value, ttl) {
  cache.delete(key);
  cache.set(key, { value: value, expiresAt: Date.now() + ttl });
  while (cache.size > MAX_CACHE_SIZE) cache.delete(cache.keys().next().value);
  return value;
}

async function getJson(url, label) {
  const response = await fetch(url, {
    method: 'GET',
    headers: { Accept: 'application/json', 'User-Agent': 'motion/' + MODULE_VERSION }
  });
  if (!response.ok) throw new Error(label + ' failed: HTTP ' + response.status);
  return response.json();
}

async function resolveTidalId(isrc) {
  const key = 'isrc:' + isrc;
  const cached = readCache(key);
  if (cached !== undefined) return cached;
  if (pending.has(key)) return pending.get(key);

  const task = (async function () {
    try {
      const payload = await getJson(ISRC_API + '/resolve/' + encodeURIComponent(isrc), 'ISRC resolver');
      const matches = payload && payload.success === true && payload.tidal &&
        payload.tidal.status === 'found' && Array.isArray(payload.tidal.matches)
        ? payload.tidal.matches : [];

      const exact = matches.filter(function (match) {
        return match && /^\d+$/.test(String(match.id || '')) && normalizeIsrc(match.isrc) === isrc;
      });
      exact.sort(function (a, b) {
        return (Number(b.popularity) || 0) - (Number(a.popularity) || 0);
      });

      const id = exact.length ? String(exact[0].id) : null;
      return writeCache(key, id, id ? POSITIVE_TTL : NEGATIVE_TTL);
    } catch (_) {
      return writeCache(key, null, NEGATIVE_TTL);
    } finally {
      pending.delete(key);
    }
  })();

  pending.set(key, task);
  return task;
}

function extractTrack(payload) {
  let node = payload;
  for (let i = 0; i < 6 && node && typeof node === 'object'; i++) {
    if (node.album || node.videoCover) return node;
    if (!node.data || typeof node.data !== 'object') break;
    node = node.data;
  }
  return null;
}

function makeVideoUrl(value) {
  if (typeof value !== 'string' || !value.trim()) return null;
  const raw = value.trim();
  if (/^https:\/\//i.test(raw)) return raw;

  // TIDAL videoCover may be supplied as a UUID-like identifier.
  const path = raw.replace(/-/g, '/').replace(/^\/+|\/+$/g, '');
  if (!/^[a-f0-9]{8}\/[a-f0-9]{4}\/[a-f0-9]{4}\/[a-f0-9]{4}\/[a-f0-9]{12}$/i.test(path)) {
    return null;
  }
  return 'https://resources.tidal.com/images/' + path + '/1280x1280.mp4';
}

async function getAnimatedCover(trackId) {
  const key = 'cover:' + trackId;
  const cached = readCache(key);
  if (cached !== undefined) return cached;
  if (pending.has(key)) return pending.get(key);

  const task = (async function () {
    try {
      const payload = await getJson(
        TIDAL_API + '/info/?id=' + encodeURIComponent(trackId),
        'TIDAL info lookup'
      );
      const track = extractTrack(payload);
      const album = track && track.album ? track.album : null;
      const cover = makeVideoUrl((album && album.videoCover) || (track && track.videoCover));
      return writeCache(key, cover, cover ? POSITIVE_TTL : NEGATIVE_TTL);
    } catch (_) {
      return writeCache(key, null, NEGATIVE_TTL);
    } finally {
      pending.delete(key);
    }
  })();

  pending.set(key, task);
  return task;
}

async function getAnimatedArtwork(albumId, country, shape, context) {
  // Album identifiers are not assumed to be TIDAL IDs. Artwork is resolved
  // from an ISRC supplied by the module playback context, when available.
  const isrc = contextIsrc([context, shape, country, albumId]);
  if (!isrc) return null;

  const tidalId = await resolveTidalId(isrc);
  if (!tidalId) return null;
  return getAnimatedCover(tidalId);
}

async function getAnimatedArtistArtwork() {
  // Artist motion artwork is not part of the TIDAL-only v1 implementation.
  return null;
}

return {
  id: 'motion',
  name: 'Motion',
  version: MODULE_VERSION,
  description: 'TIDAL animated album artwork resolved through track ISRCs.',
  getAnimatedArtwork: getAnimatedArtwork,
  getAnimatedArtistArtwork: getAnimatedArtistArtwork
};
